# Environnement API (local | preprod | production)
EXPO_PUBLIC_APP_ENV=preprod
EXPO_PUBLIC_API_URL=https://api-preprod.laplasse.tech/api

# Google Maps SDK — rebuild APK/EAS requis après changement
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Sans clé native : fallback WebView OSM automatique.
