# Environnement API (local | preprod | production)
# Si EXPO_PUBLIC_API_URL est défini, il prend le dessus sur APP_ENV.
EXPO_PUBLIC_APP_ENV=preprod
EXPO_PUBLIC_API_URL=https://api-preprod.laplasse.tech/api

# Dev local (copier en .env.development) :
# EXPO_PUBLIC_APP_ENV=local
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
