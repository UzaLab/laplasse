{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:preprod": "EXPO_PUBLIC_APP_ENV=preprod EXPO_PUBLIC_API_URL=https://api-preprod.laplasse.tech/api expo start",
    "web:preprod": "EXPO_PUBLIC_APP_ENV=preprod EXPO_PUBLIC_API_URL=https://api-preprod.laplasse.tech/api expo start --web",
    "start:staging": "pnpm start:preprod",
    "start:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:local": "bash scripts/build-local.sh preview android",
    "build:local:preview": "bash scripts/build-local.sh preview android",
    "build:local:preview:lite": "BUILD_LOW_RESOURCE=1 bash scripts/build-local.sh preview android",
    "build:local:production": "bash scripts/build-local.sh production android",
    "build:local:dev": "bash scripts/build-local.sh development android"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "^57.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@laplasse/api-client": "workspace:*",
    "@laplasse/shared-config": "workspace:*",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@tanstack/react-query": "^5.101.0",
    "babel-preset-expo": "~57.0.6",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
